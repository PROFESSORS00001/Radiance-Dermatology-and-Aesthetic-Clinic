{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/app.js",
      "use": "@vercel/node"
    },
    {
      "src": "patient-app/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/dist/**",
      "use": "@vercel/static"
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": true
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/src/app.js"
    },
    {
      "src": "/admin/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/admin/(.*\\..*)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/admin(.*)",
      "dest": "frontend/dist/index.html"
    },
    {
      "src": "/dashboard/assets/(.*)",
      "dest": "frontend/dist/assets/$1"
    },
    {
      "src": "/dashboard/(.*\\..*)",
      "dest": "frontend/dist/$1"
    },
    {
      "src": "/dashboard(.*)",
      "dest": "frontend/dist/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "patient-app/$1"
    }
  ]
}
